@import "if-financial.mapcss";
@import "if-food.mapcss";
@import "if-hotel.mapcss";
@import "if-medical.mapcss";
@import "if-postal.mapcss";
@import "if-publictransport.mapcss";
@import "if-railway.mapcss";
