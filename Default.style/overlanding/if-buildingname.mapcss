

@if BuildingName

    area|z17-[building],
    |z17-[landuse=construction] {
        text: eval(cond(tag('addr:housenumber'),
                    tag('addr:housenumber') . cond(tag('addr:unit'),
                        ' ' . tag('addr:unit'),
                        ''
                    ) . cond(any(locTag('name'), tag('addr:housename')),
                        ' (' . any(locTag('name'), tag('addr:housename')) . ')',
                        ''
                    ),
                    any(locTag('name'), tag('addr:housename'))));
        [wikipedia],[website],[contact:website] {
            text: eval(cond(tag('addr:housenumber'),
                        tag('addr:housenumber') . cond(tag('addr:unit'),
                            ' ' . tag('addr:unit'),
                            ''
                        ) . cond(any(locTag('name'), tag('addr:housename')),
                            ' (' . any(locTag('name'), tag('addr:housename')) . ')',
                            ''
                        ),
                        any(locTag('name'), tag('addr:housename'))) . "⬈");
        }
        text-color: @color_building_text;
        font-size: 10;
        font-stroke-width: 0.8pt;
        font-stroke-color: @color_label_stroke;
        text-priority: 2;
    }

    node|z17-[place=city_block] {
        text: eval(locTag('name'));
        text-color: @color_building_text;
        font-size: 10;
        font-stroke-width: 0.8pt;
        text-priority: 0;
        [wikipedia],[website],[contact:website] {
            text-color: @color_text_wikipedia;
                    text: eval(locTag('name') . "⬈");
        }
    }
   node|z17-[office] {
        text: eval(locTag('name'));
        text-color: @color_building_text;
        font-size: 10;
        font-stroke-width: 0.8pt;
        text-priority: 0;
        [wikipedia],[website],[contact:website] {
            text-color: @color_text_wikipedia;
                    text: eval(locTag('name') . "⬈");
        }
    }

    node|z18-([addr:housenumber],
        [addr:housename]) {
        text: eval(cond(locTag('name'),
                    locTag('name'),
                    cond(tag('addr:housenumber'),
                        tag('addr:housenumber') . cond(tag('addr:housename'), ' (' . tag('addr:housename') . ')', ''),
                        tag('addr:housename'))));
        [wikipedia],[website],[contact:website] {
        text: eval(cond(locTag('name'),
                    locTag('name'),
                    cond(tag('addr:housenumber'),
                        tag('addr:housenumber') . cond(tag('addr:housename'), ' (' . tag('addr:housename') . ')', ''),
                        tag('addr:housename'))) . "⬈");
        }
        text-color: @color_building_text;
        font-size: 9;
        font-stroke-width: 0.8pt;
        text-priority: 1;
    }

    node|z17-[entrance][ !indoor] {
        icon-image: "poi_circle_small.svg";
        icon-tint: @color_entrance_text;
        text-priority: -5;
        icon-scale: 0.7;
        

        |z18- {
            icon-image: "poi_entrance.svg";
            icon-scale: 0.8;

            

            [addr:housenumber] {
                text: eval(tag('addr:housenumber'));
                text-color: @color_building_text;
                font-size: 9;
            }

            [ref] {
                text: eval(tag('ref'));
                text-color: @color_entrance_text;
                font-size: 8;
            }
        }
    }

@endif