        }

        [amenity=nightclub] {
            icon-image: "poi_disco.svg";
            icon-tint: @color_icon_food;
            |z17-{
                text: eval(locTag('name'));
                text-color: @color_text_food;
                [wikipedia],[website],[contact:website] {
