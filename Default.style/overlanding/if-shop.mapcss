

@if AllShops
    // all kinds of shops
    |z17-[shop]{
        icon-image: "poi_circle.svg";
        icon-tint: @color_icon_stores;
        text: eval(locTag('name'));
        text-color: @color_text_stores;
        text-priority:-1;
        [wikipedia],[website],[contact:website] {
            text-color: @color_text_wikipedia;
                    text: eval(locTag('name') . "⬈");
        }
    }
@endif

@if Shop
|z16-{
    [shop=supermarket] {
        icon-image: "poi_supermarket.svg";
        icon-tint: @color_icon_stores;
        icon-scale: @icon_small;
        |z17-{
            text: eval(locTag('name'));
            text-color: @color_text_stores;
            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                    text: eval(locTag('name') . "⬈");
            }
        }
    }
    [shop=doityourself]{
        icon-image: "poi_doityourself.svg";
