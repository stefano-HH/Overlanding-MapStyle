
@if Beauty

    |z17- {
        [shop=hairdresser],
        [shop=beauty],
        [shop=tattoo] {
            icon-image: "poi_beauty_salon.svg";
            icon-tint: @color_icon_beauty;
            icon-scale: @icon_small;
            text: eval(locTag('name'));
            text-color: @color_text_beauty;

            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                text: eval(locTag('name') . "⬈");
            }
        }

        [amenity=public_bath],
        [shop=massage],
        [leisure=sauna],
        [amenity=sauna] {
            icon-image: "poi_spa.svg";
            icon-scale: @icon_small;
            icon-tint: @color_icon_beauty;
            text: eval(locTag('name'));
            text-color: @color_text_beauty;

            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                text: eval(locTag('name') . "⬈");
            }
        }
    }

@endif