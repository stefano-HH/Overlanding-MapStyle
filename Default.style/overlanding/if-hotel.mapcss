
@if Hotel

    |z17-(
        [amenity=hotel],
        [tourism=hotel],
        [tourism=hostel],
        [tourism=motel],
        [tourism=guest_house],
        [tourism=chalet],
        [tourism=alpine_hut]
    ) {
        icon-image: "poi_hotel.svg";
        icon-tint: @color_icon_hotels;
        icon-scale: @icon_x_small;

        |z17-{
            text: eval(locTag('name'));
            text-color: @color_text_hotels;

            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                text: eval(locTag('name') . "⬈");
            }
        }
    }

    |z12-[tourism=camp_site] {
        icon-image: "poi_camping.svg";
        icon-tint: @color_icon_hotels;
        icon-scale: @icon_small;
        text-priority: 10;

        |z17-{
            text: eval(locTag('name'));
            text-color: @color_text_hotels;

            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                text: eval(locTag('name') . "⬈");
            }
        }
    }

    |z12-[tourism=caravan_site] {
        icon-image: "poi_motorhome.svg";
        icon-tint: @color_icon_hotels_dark;
        icon-scale: @icon_small;
        text-priority: 10;

        |z17-{
            text: eval(locTag('name'));
            text-color: @color_text_hotels;

            [wikipedia],[website],[contact:website] {
                text-color: @color_text_wikipedia;
                text: eval(locTag('name') . "⬈");
            }
        }
    }

@endif
