
/******************************* Polygons *******************************/
area {
    [boundary=administrative] {
        // country boundaries
        [admin_level=2] {
            dashes: 1;
            width: eval( zlinear(5, 1.5pt, 2pt, 2pt,3pt,4pt,5pt ));
            color: @color_boundary_country;

            |z13-{
                casing-width: eval( zlinear(13, 5pt,8pt,12pt,15pt,20pt ));
                casing-color: @color_boundary_country_casing;
                linecap: none;
            }

        }

        // states boundaries
        |z5-[admin_level=3] {
            color: @color_boundary_state;
            dashes-width: eval( zlinear(7, 1pt,1pt,2pt,2pt,3pt,3pt,3pt,3pt,3pt ));
            dashes-color: @color_boundary_state;
            dashes: 1;
        }

        // regions
        |z7-[admin_level=4] {
            dashes: 1;
            color: @color_boundary_state;
            dashes-width: eval( zlinear(7, 1pt,1pt,2pt,2pt,3pt,3pt,3pt,3pt,3pt ));
            dashes-color: @color_boundary_state;
        }
    }

    // generalized buildings
    |z8-[landuse=residential]{
        z-index: -14;
        fill-color: @color_landuse_residential;
        text-color: @color_landuse_residential_text;
    }

    |z13-[landuse=residential] {
        text-color: @color_landuse_residential_text;
    }

    |z15-[landuse=railway]{
        z-index: -14;
        fill-color: @color_railway_area;
    }

    /* ***** National Parks ***** */

    |z8-{
        [leisure=nature_reserve],
        [leisure=natural_reserve],
        [boundary=national_park],
        [protected_class=1], [protected_class=1a], [protected_class=1b],
        [protected_class=2],
        [protected_class=3],
        [protected_class=4],
        [protected_class=5],
        |z10-[protected_class=6] {
            z-index: 2;
            text: eval(locTag('name'));
            color: @color_nationalpark_border;
            width: eval( zlinear( 8, 4pt,5pt,7pt,10pt ) );
            font-size: 12pt;
            font-weight: bolder;
            text-color: @color_nationalpark_text;
            text-priority: 4;
            font-stroke-width: 4px;
            font-stroke-color: @color_wood;
 /*           fill-image: @image_national_park_area; */
            fill-color: @color_nationalpark_fill_light;

            [wikipedia],[website],[contact:website] {
                text: eval(locTag('name') . "⬈");
            }
        }
    }

    |z15-{
        [natural=wood], [landuse=forest] {
            fill-image: @image_wood;
        }
    }

    |z9-[landuse=basin],
    [natural=water],
    [landuse=reservoir],
    [waterway=riverbank] {
        z-index: -12;
        fill-color: @color_water;
        width: eval( zlinear( 9, 1px,1.5px ) );
        color: @color_water;
    }

    |z12-{
        [natural=bay],
        [waterway=riverbank],
        [natural=water],
        [landuse=basin],
        [landuse=reservoir] {
            text: eval(locTag('name'));
            text-color: @color_water_text;
            font-stroke-width: 2pt;
            font-stroke-color: @color_water;
            font-size: 8;

            [wikipedia],[website],[contact:website] {
                text: eval(locTag('name') . "⬈");
            }

            |z14-[natural=bay],
            |z14-[waterway=riverbank],
            |z15-[natural=water],
            |z16-[landuse=basin],
            |z16-[landuse=reservoir] {
                font-size: 10pt;
                font-stroke-width: 2pt;
                text-priority: 2;
            }
        }
    }

    |z13-{
        [natural=scrub] {
            z-index: -13;
            fill-color: @color_scrub;
        }

        [leisure=park], [leisure=garden], [tourism=zoo] {
            z-index: -13;
            fill-color: @color_wood;
        }

        [landuse=orchard], [landuse=vineyard], [landuse=plant_nursery], [landuse=greenhouse_horticulture] {
            z-index: -13;
            fill-color: @color_orchard;
        }

        [landuse=allotments] {
            z-index: -13;
            fill-color: @color_allotments;
        }
    }

    [natural=oceanwater],
    [natural=bay] {
        z-index: -12;
        fill-color: @color_oceanwater;
    }

    // parkings
    |z16-{
        [landuse=garages],[amenity=parking] {
            z-index: -11;
            fill-color: @color_landuse_parking;
            color: @color_icon_parking;
            width: 1pt;
            details-enabled: 0;
            text-priority: -3;

            |z18-{
                icon-image: "poi_parking.svg";
                icon-tint: @color_icon_parking;
                icon-scale: @icon_small;
                text: eval(locTag('name'));
                text-color: @color_text_transport;
                icon-tint: @color_icon_parking;

                [wikipedia],[website],[contact:website] {
                    text: eval(locTag('name') . "⬈");
                }
            }
        }

        [landuse=garages] {
            fill-color: @color_building;
        }
    }

    |z5-{
        |z9-[natural=bay],
        |z9-[landuse=basin],
        [natural=water], [landuse=reservoir], [waterway=riverbank] {
            fill-color: @color_water;

            [intermittent=yes] {
                z-index: -2;
                fill-image: @intermittent_water;
            }
        }
    }

    [natural=wetland] {
        z-index: 1;
        |z9-11 {
            fill-color: @color_wetland;
        }
        |z12- {
            fill-image: @image_wetland;
            text-color: @color_wetland_text;
            font-stroke-color: @color_wetland_stroke;
            font-stroke-width: 1.5pt;
        }
    }

    // fill image of military area desplayed on top of the other objects
    |z11-{
        [landuse=military],[military=danger_area] {
            z-index: 2;
            fill-image: @image_forbidden_area;
            color: @color_forbidden;
            width: 3pt;
        }
    }

    // all buildings
    [building] {
        |z13-{
            z-index: 3;
            fill-color: @color_building;
        }

        // building stroke
        |z16-{
            z-index: 3;
            width: 1pt;
            color: @color_building_stroke;
            fill-color: @color_building;
        }
    }

}

/******************************* Polygon strokes *******************************/

// all barriers displayed as thin red line. Hedge is dark-green.
area,line|z12-[barrier]{
	width: 2pt;
	color: @color_barrier;
}
